# Copy this file to .env and fill in your values.
# cp .env.example .env

# Server port (default: 5000)
PORT=5000

# MongoDB connection string
# Local:  mongodb://localhost:27017/farmershub
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/farmershub
MONGO_URI=mongodb://localhost:27017/farmershub

# JWT signing secret — change this in any non-development environment
JWT_SECRET=farmershub-dev-secret-change-in-production

# Allowed CORS origins (comma-separated)
# Add your Live Server origin here (usually port 5500 or 5501)
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

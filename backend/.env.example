# Copy this file to .env and fill in your values.
# cp .env.example .env

# Server port (default: 5000)
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/farmershub?retryWrites=true&w=majority

# Replace these placeholders with private values in your local .env or hosting dashboard.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=sonam@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-private-password
ADMIN_NAME=FarmersHub Administrator

# Allowed CORS origins (comma-separated)
# Include local frontend origins and your deployed frontend domain.
# Example deployed frontend: https://<username>.github.io
CLIENT_ORIGIN=https://your-frontend-domain.com
